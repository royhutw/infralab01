# ==============================================================================
#  config.env
#  CORP.FOO.BAR.TW 802.1X / PKI / FreeRADIUS 集中化共用環境參數設定檔
# ==============================================================================

# ── [1. 網域與 AD / LDAP 基本參數] ───────────────────────────────────────────
DOMAIN="corp.foo.bar.tw"
REALM="CORP.FOO.BAR.TW"
NETBIOS="CORP"

SHORT_HOSTNAME="radius3"
HOSTNAME_FQDN="${SHORT_HOSTNAME}.${DOMAIN}"
MACHINE_ACCOUNT="${SHORT_HOSTNAME^^}$"
MACHINE_PRINCIPAL="${SHORT_HOSTNAME^^}\$@${REALM}"

# 本機 IP 位址 (留空時由 01 腳本自動偵測預設網卡 IPv4 位址)
HOST_IP=""

# 加入 AD 網域使用的管理員帳號
AD_ADMIN_USER="Administrator"
KEYTAB_PATH="/etc/krb5.keytab"

# AD 搜尋根目錄與 802.1X 群組專用 OU
BASE_DN="DC=corp,DC=foo,DC=bar,DC=tw"
HQ_GROUP_OU="OU=8021X-HQ,OU=HQ,${BASE_DN}"

# 自動透過 DNS SRV 紀錄偵測 AD Domain Controller FQDN (若偵測失敗則預設使用 dc01)
DETECTED_DC=$(host -t SRV "_ldap._tcp.dc._msdcs.${DOMAIN}" 2>/dev/null | awk '{print $NF}' | sed 's/\.$//' | head -n 1 || true)
DC_FQDN="${DETECTED_DC:-dc01.${DOMAIN}}"
LDAP_SERVER="ldap://${DC_FQDN}"

# ── [2. PKI 憑證信任鏈與 CRL 下載 URL 參數] ──────────────────────────────────
CRL_BASE_URL="http://crl.${DOMAIN}"
SUBCA_HOSTNAME="adcs.${DOMAIN}"
SUBCA_COMMON_NAME="corp-foo-bar-tw-SubCA"

# Root CA 與 Sub CA 憑證下載 URL
ROOT_CA_CRT_URL="${CRL_BASE_URL}/RootCA.crt"
SUB_CA_CRT_URL="${CRL_BASE_URL}/AIA/${SUBCA_HOSTNAME}_${SUBCA_COMMON_NAME}.crt"

# Root CA 與 Sub CA CRL (憑證撤銷清冊) 下載 URL
ROOT_CRL_NAME="RootCA"
SUBCA_CRL_NAME="${SUBCA_COMMON_NAME}"
ROOT_CRL_URL="${CRL_BASE_URL}/${ROOT_CRL_NAME}.crl"
SUB_CRL_URL="${CRL_BASE_URL}/CRL/${SUBCA_CRL_NAME}.crl"

# 本機系統 CA 憑證存放路徑
LOCAL_ROOT_CA_CRT="/usr/local/share/ca-certificates/RootCA.crt"
LOCAL_SUB_CA_CRT="/usr/local/share/ca-certificates/SubCA.crt"

# ── [3. CEP/CES 與 Certmonger 憑證申請參數] ──────────────────────────────────
CEPCES_SERVER="cepces1.${DOMAIN}"
CEP_ENDPOINT="https://${CEPCES_SERVER}/ADPolicyProvider_CEP_Kerberos/service.svc/CEP"

CEPCES_GIT_URL="https://github.com/openSUSE/cepces.git"
CEPCES_VENV_DIR="/opt/cepces"
CEPCES_SRC_DIR="/opt/cepces-src"
CEPCES_SUBMIT_BIN="/usr/local/bin/cepces-submit"

CA_NAME="CEP-CES"
REQUEST_ID="RADIUS-EAP-TLS"
PROFILE_NAME="EAP-TLS-NPS-Server"
KEY_SIZE="4096"

CERT_PATH="/etc/ssl/certs/${SHORT_HOSTNAME}.crt"
KEY_PATH="/etc/ssl/private/${SHORT_HOSTNAME}.key"

# 憑證核發或自動續約後的自動化處理腳本 (修正私鑰權限並重載 FreeRADIUS)
POST_SAVE_CMD="/bin/chown root:freerad ${KEY_PATH} ${CERT_PATH} 2>/dev/null || true; /bin/chmod 640 ${KEY_PATH}; /bin/systemctl reload freeradius 2>/dev/null || true"

# ── [4. FreeRADIUS 與交換器 (RADIUS Clients) / 動態 VLAN / VoIP OUI 參數] ───
SW_SUBNET="192.168.10.0/24"
SW_SECRET="P@ssw0rd"
SW_SHORTNAME="SW-HQ-Edge"

GUEST_VLAN="90"
VOICE_VLAN="38"
REAUTH_TIMEOUT="86400"
EAP_FRAGMENT_SIZE="1024"

# 多廠牌 VoIP 話機 MAC OUI 自動放行清單 (前 6 碼 Hex，不分大小寫，以 | 分隔)
# 對照表：
#   0c383e : Fanvil (X3S 等系列)
#   0001e3 : SiemensAGPhone
#   00036b : CiscoPhone1
#   001243 : CiscoPhone2
#   00096e : AvayaPhone1
#   00040d : AvayaPhone2
#   001b4f : AvayaPhone3
#   000fe2 : Huawei-3COMPhone
#   0060b9 : NEC_PhilipsPhone
#   00d01e : PingtelPhone
#   00e075 : VeritelPolycomPhone1
#   0004f2 : VeritelPolycomPhone2
#   0011a6 : VeritelPolycomPhone3
#   00e0bb : 3COMPhone
#   000b82 : Grandstream
#   001565 : Yealink
VOIP_OUI_REGEX="^(0c383e|0001e3|00036b|001243|00096e|00040d|001b4f|000fe2|0060b9|00d01e|00e075|0004f2|0011a6|00e0bb|000b82|001565)"

FR_CONF_DIR="/etc/freeradius/3.0"
CORP_CA_CHAIN="${FR_CONF_DIR}/certs/corp_ca_chain.pem"
KRB5_CCACHE_DIR="/var/lib/freeradius"
KRB5_CCACHE="${KRB5_CCACHE_DIR}/krb5cc_freerad"

# ── [5. CRL 自動同步與背景定時任務參數] ──────────────────────────────────────
SYNC_SCRIPT_PATH="/usr/local/bin/update-freeradius-crl.sh"
INSTALLED_ENV_FILE="${FR_CONF_DIR}/corp_8021x.env"
CRL_SYNC_INTERVAL="4h"

# ── [6. NAC JSON 結構化稽核日誌與 Logrotate 參數 (供 Wazuh 收集)] ────────────
NAC_AUDIT_LOG_DIR="/var/log/freeradius"
NAC_AUDIT_JSON_FILE="${NAC_AUDIT_LOG_DIR}/nac_audit.json"
LOGROTATE_RETENTION_DAYS="90"